
#!/bin/bash

set -e

DIR="/etc/ssh/sshd_config.d"

GRUPOS=(
    "GS_Linux_DBA_UNA"
    "GS_Linux_DBA_UNA@grupouniasselvi.local"
    "GS_Linux_DBA_UNC"
    "GS_Linux_DBA_UNC@adm-cesumar.local"
    "GS_Linux_DBA_VTR"
)

ARQUIVOS=(
    "01-vitru.conf"
    "10-vitru.conf"
)

for ARQUIVO in "${ARQUIVOS[@]}"; do

    CAMINHO="$DIR/$ARQUIVO"

    echo "Configurando $CAMINHO..."

    for GRUPO in "${GRUPOS[@]}"; do

        if grep -qE "^AllowGroups.*(^|[[:space:]])${GRUPO}([[:space:]]|$)" "$CAMINHO"; then
            echo "Grupo $GRUPO já existe."
        else
            sed -i "/^AllowGroups/ s/$/ $GRUPO/" "$CAMINHO"
            echo "Grupo $GRUPO adicionado."
        fi

    done

done

echo "Validando configuração SSH..."

sshd -t

echo "Configuração validada."
