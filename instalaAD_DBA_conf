#!/bin/bash

set -e

DIR="/etc/sudoers.d"

# =========================================================
# Vitru
# =========================================================
echo "Configurando grupos DBA Vitru..."

cat >> "$DIR/10-vitru" <<EOF

# DBA Vitru
%GS_Linux_DBA_VTR ALL=(ALL) ALL
EOF

# =========================================================
# Unicesumar
# =========================================================
echo "Configurando grupos DBA Unicesumar..."

cat >> "$DIR/30-unicesumar" <<EOF

# DBA Unicesumar
%GS_Linux_DBA_UNC ALL=(ALL) ALL
%GS_Linux_DBA_UNC@adm-cesumar.local ALL=(ALL) ALL
EOF

# =========================================================
# Uniasselvi
# =========================================================
echo "Configurando grupos DBA Uniasselvi..."

cat >> "$DIR/20-uniasselvi" <<EOF

# DBA Uniasselvi
%GS_Linux_DBA_UNA ALL=(ALL) ALL
%GS_Linux_DBA_UNA@grupouniasselvi.local ALL=(ALL) ALL
EOF

# =========================================================
# Validacao
# =========================================================
echo "Validando sudoers..."

if visudo -cf /etc/sudoers; then
    echo "Configuracao validada com sucesso!"
else
    echo "ERRO: Configuracao invalida!"
    exit 1
fi

echo "Finalizado."
